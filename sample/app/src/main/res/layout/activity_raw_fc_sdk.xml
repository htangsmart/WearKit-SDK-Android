<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.github.kilnn.tool.widget.item.PreferenceItem
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="Special Feature"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp">

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_taxi"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Taxi"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
