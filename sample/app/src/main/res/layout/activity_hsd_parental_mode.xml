<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_enabled"
            style="@style/Widget.Sample.PreferenceView.Item.Switch"
            app:preferenceTitle="Enabled" />

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_time_setting"
            style="@style/Widget.Sample.PreferenceView.Item.Switch"
            app:preferenceTitle="Time Setting" />

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_enter_setting"
            style="@style/Widget.Sample.PreferenceView.Item.Switch"
            app:preferenceTitle="Enter Setting" />

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_alarm_setting"
            style="@style/Widget.Sample.PreferenceView.Item.Switch"
            app:preferenceTitle="Alarm Setting" />

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_game_duration"
            style="@style/Widget.Sample.PreferenceView.Item.Switch"
            app:preferenceTitle="Game Duration" />

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_game_start_time"
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="Game Start Time" />

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_game_end_time"
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="Game End Time" />

        <Button
            android:id="@+id/btn_request"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="Request" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="@string/action_save" />

    </LinearLayout>

</ScrollView>
