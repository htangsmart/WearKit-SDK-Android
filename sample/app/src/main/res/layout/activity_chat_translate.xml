<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#333333"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tv_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ds_speech_ready"
        android:textColor="#666666"/>

    <ScrollView
        android:id="@+id/scroll_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ll_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ds_speech_chat_translate_empty"
        android:textColor="#666666"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ds_speech_lang_self"
        android:textStyle="bold"/>

    <RadioGroup
        android:id="@+id/rg_self_lang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkedButton="@id/rb_self_zh"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_self_zh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ds_speech_lang_zh"/>

        <RadioButton
            android:id="@+id/rb_self_en"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/ds_speech_lang_en"/>
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ds_speech_lang_peer"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_swap_lang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ds_speech_lang_swap"/>
    </LinearLayout>

    <RadioGroup
        android:id="@+id/rg_peer_lang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkedButton="@id/rb_peer_en"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_peer_zh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ds_speech_lang_zh"/>

        <RadioButton
            android:id="@+id/rb_peer_en"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/ds_speech_lang_en"/>
    </RadioGroup>

    <LinearLayout
        android:id="@+id/ll_start_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_self_phone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ds_speech_ct_self_phone"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_self_sco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/ds_speech_ct_self_headset"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_peer_sco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/ds_speech_ct_peer_headset"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_peer_phone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/ds_speech_ct_peer_phone"
            android:visibility="gone"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_stop_session"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:enabled="false"
        android:text="@string/ds_speech_ct_stop_session"/>

    <Button
        android:id="@+id/btn_exit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ds_speech_exit"/>

</LinearLayout>
