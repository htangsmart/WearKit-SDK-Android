<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.github.kilnn.tool.widget.item.PreferenceItem
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="DanMu"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp">

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_ugreen_add_mine"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Add Mine DanMu"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_ugreen_add_friend"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Add Friend DanMu"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_ugreen_clear_all"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Clear All"/>

        </LinearLayout>

        <com.github.kilnn.tool.widget.item.PreferenceItem
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="Config"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp">

            <TextView
                android:id="@+id/tv_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Config: (request first)"
                android:textColor="#666666"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_request_config"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Request Config"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_desk_mode"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Desk Mode"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_key_function"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Key Function"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_keep_screen_on"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Keep Screen On"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_lyric_theme"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Lyric Theme"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_lyric_color"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Lyric Color"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
