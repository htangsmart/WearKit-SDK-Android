<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_game_lock_switch"
            style="@style/Widget.Sample.PreferenceView.Item.Switch"
            app:preferenceTitle="@string/lock_enabled"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:text="@string/lock_password"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:hint="@string/lock_password_hint"
            android:inputType="numberPassword"
            android:maxLength="6"/>

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_start_time"
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="@string/ds_config_start_time"/>

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_end_time"
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="@string/ds_config_end_time"/>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:text="@string/action_save"/>
    </LinearLayout>
</ScrollView>
