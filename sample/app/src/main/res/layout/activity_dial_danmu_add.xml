<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_custom_style_danmu_text"
                android:textAppearance="?textAppearanceSubtitle1"/>

            <EditText
                android:id="@+id/edit_danmu_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/dial_custom_style_danmu_text_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="2"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_custom_style_danmu_position"
                android:textAppearance="?textAppearanceSubtitle1"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dial_custom_style_danmu_coord_x"/>

            <RadioGroup
                android:id="@+id/rg_text_x"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@id/rb_text_x_absolute"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_text_x_absolute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_custom_style_danmu_coord_absolute"/>

                <RadioButton
                    android:id="@+id/rb_text_x_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_coord_left"/>

                <RadioButton
                    android:id="@+id/rb_text_x_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_coord_right"/>

                <RadioButton
                    android:id="@+id/rb_text_x_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_coord_center"/>
            </RadioGroup>

            <EditText
                android:id="@+id/edit_text_x"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="numberSigned"
                android:maxLines="1"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dial_custom_style_danmu_coord_y"/>

            <RadioGroup
                android:id="@+id/rg_text_y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@id/rb_text_y_absolute"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_text_y_absolute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_custom_style_danmu_coord_absolute"/>

                <RadioButton
                    android:id="@+id/rb_text_y_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_coord_top"/>

                <RadioButton
                    android:id="@+id/rb_text_y_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_coord_bottom"/>

                <RadioButton
                    android:id="@+id/rb_text_y_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_coord_center"/>
            </RadioGroup>

            <EditText
                android:id="@+id/edit_text_y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="numberSigned"
                android:maxLines="1"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_custom_style_danmu_font_style"
                android:textAppearance="?textAppearanceSubtitle1"/>

            <Button
                android:id="@+id/btn_font_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_custom_style_danmu_font_size"
                android:textAppearance="?textAppearanceSubtitle1"/>

            <Button
                android:id="@+id/btn_font_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_custom_style_danmu_text_color"
                android:textAppearance="?textAppearanceSubtitle1"/>

            <Button
                android:id="@+id/btn_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_select"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_custom_style_danmu_direction"
                android:textAppearance="?textAppearanceSubtitle1"/>

            <RadioGroup
                android:id="@+id/rg_direction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checkedButton="@id/rb_direction_left"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_direction_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_custom_style_danmu_direction_left"/>

                <RadioButton
                    android:id="@+id/rb_direction_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_direction_right"/>
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_custom_style_danmu_walk_speed"
                android:textAppearance="?textAppearanceSubtitle1"/>

            <Button
                android:id="@+id/btn_walk_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_custom_style_danmu_animation"
                android:textAppearance="?textAppearanceSubtitle1"/>

            <RadioGroup
                android:id="@+id/rg_animation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checkedButton="@id/rb_anim_none"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_anim_none"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_custom_style_danmu_animation_none"/>

                <RadioButton
                    android:id="@+id/rb_anim_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_custom_style_danmu_animation_1"/>

                <RadioButton
                    android:id="@+id/rb_anim_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_custom_style_danmu_animation_2"/>

                <RadioButton
                    android:id="@+id/rb_anim_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_custom_style_danmu_animation_3"/>
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dial_custom_style_danmu_animation_position"
                android:textAppearance="?textAppearanceSubtitle1"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dial_custom_style_danmu_coord_x"/>

            <RadioGroup
                android:id="@+id/rg_anim_x"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@id/rb_anim_x_absolute"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_anim_x_absolute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_custom_style_danmu_coord_absolute"/>

                <RadioButton
                    android:id="@+id/rb_anim_x_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_coord_left"/>

                <RadioButton
                    android:id="@+id/rb_anim_x_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_coord_right"/>

                <RadioButton
                    android:id="@+id/rb_anim_x_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_coord_center"/>
            </RadioGroup>

            <EditText
                android:id="@+id/edit_anim_x"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="numberSigned"
                android:maxLines="1"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dial_custom_style_danmu_coord_y"/>

            <RadioGroup
                android:id="@+id/rg_anim_y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@id/rb_anim_y_absolute"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_anim_y_absolute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dial_custom_style_danmu_coord_absolute"/>

                <RadioButton
                    android:id="@+id/rb_anim_y_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_coord_top"/>

                <RadioButton
                    android:id="@+id/rb_anim_y_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_coord_bottom"/>

                <RadioButton
                    android:id="@+id/rb_anim_y_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/dial_custom_style_danmu_coord_center"/>
            </RadioGroup>

            <EditText
                android:id="@+id/edit_anim_y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="numberSigned"
                android:maxLines="1"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="@string/action_add"
        app:cornerRadius="64dp"/>

</LinearLayout>
