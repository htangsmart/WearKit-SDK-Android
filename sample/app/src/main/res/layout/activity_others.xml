<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.github.kilnn.tool.widget.item.PreferenceItem
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="华盛达(Hsd)"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp">

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_ICE"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="ICE"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_parental_mode"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Parental Mode"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_class_room_mode"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="ClassRoom Mode"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_task_reward"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Task &amp; Reward"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_habit"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Habit"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_usage_info"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Usage Info"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_game"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Game"/>

        </LinearLayout>

        <com.github.kilnn.tool.widget.item.PreferenceItem
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="Offline Map"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp">

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_push_offline_map"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Push"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_list_offline_map"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="List"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_delete_offline_map"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Delete"/>

        </LinearLayout>

        <com.github.kilnn.tool.widget.item.PreferenceItem
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="ABMate Wifi Test"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp">

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_abmate_take_photo"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Create a image file"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_abmate_get_file_names"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Get file names"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_abmate_pull_files"
                style="@style/Widget.Sample.PreferenceView.Item"
                app:preferenceTitle="Pull files"/>

            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_abmate_rtsp"
                style="@style/Widget.Sample.PreferenceView.Item.Text"
                app:preferenceTitle="RTSP Stream"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>